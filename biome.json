{
	"$schema": "https://schemas.biomejs.dev/biome/2.0/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"includes": [
			"**",
			"!.claude/settings.local.json",
			"!.emulator-seed",
			"!.tmp"
		]
	},
	"overrides": [
		{
			"includes": ["assets/**"],
			"linter": {
				"rules": {
					"a11y": {
						"noSvgWithoutTitle": "off"
					}
				}
			}
		}
	]
}
