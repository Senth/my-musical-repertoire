{
	"name": "my-musical-repertoire",
	"main": "expo-router/entry",
	"version": "1.0.0",
	"scripts": {
		"start": "expo start",
		"reset-project": "node ./scripts/reset-project.js",
		"android": "expo start --android",
		"ios": "expo start --ios",
		"web": "expo start --web --port $(scripts/dev-stack.sh dev-port)",
		"build:web": "expo export --platform web",
		"deploy:dev": "firebase deploy --only firestore:rules,firestore:indexes --project default",
		"lint": "biome check",
		"typecheck": "tsc --noEmit",
		"invariants": "scripts/check-invariants.sh",
		"format": "biome format --write",
		"test": "jest",
		"e2e": "playwright test",
		"fixture": "playwright test --config=playwright.fixture.config.ts",
		"emulators": "firebase emulators:start --import .emulator-seed",
		"emulators:export": "firebase emulators:export .emulator-seed --force"
	},
	"jest": {
		"preset": "jest-expo",
		"transformIgnorePatterns": [
			"node_modules/(?!((jest-)?react-native|@react-native(-community)?|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@unimodules/.*|unimodules|sentry-expo|native-base|react-native-svg|@react-native-firebase|firebase|react-native-paper|nativewind|react-native-css-interop))"
		],
		"testPathIgnorePatterns": [
			"/node_modules/",
			"/e2e/",
			"/.tmp/"
		]
	},
	"dependencies": {
		"@expo/vector-icons": "15.1.1",
		"@react-native-async-storage/async-storage": "^3.1.0",
		"@react-native-community/slider": "^5.2.0",
		"@react-navigation/bottom-tabs": "7.18.18",
		"@react-navigation/native": "7.3.18",
		"@tailwindcss/postcss": "4.3.3",
		"expo": "55.0.31",
		"expo-auth-session": "55.0.18",
		"expo-constants": "55.0.17",
		"expo-crypto": "55.0.19",
		"expo-font": "55.0.8",
		"expo-linking": "55.0.17",
		"expo-localization": "55.0.19",
		"expo-router": "55.0.18",
		"expo-splash-screen": "55.0.25",
		"expo-status-bar": "55.0.6",
		"expo-symbols": "55.0.9",
		"expo-web-browser": "55.0.20",
		"firebase": "12.18.0",
		"i18next": "26.4.1",
		"nativewind": "5.0.0-preview.4",
		"react": "19.2.8",
		"react-dom": "19.2.8",
		"react-i18next": "17.0.13",
		"react-native": "0.87.1",
		"react-native-css": "3.0.7",
		"react-native-css-interop": "0.2.6",
		"react-native-draggable-flatlist": "^4.0.3",
		"react-native-gesture-handler": "3.2.1",
		"react-native-paper": "5.15.3",
		"react-native-reanimated": "4.6.0",
		"react-native-safe-area-context": "5.9.1",
		"react-native-screens": "4.27.0",
		"react-native-svg": "15.15.5",
		"react-native-web": "0.21.2",
		"react-native-worklets": "0.12.1",
		"tailwindcss": "4"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.11",
		"@playwright/test": "^1.62.1",
		"@react-native/jest-preset": "^0.87.0",
		"@testing-library/react-native": "~13",
		"@types/jest": "~30",
		"@types/node": "^26.3.0",
		"@types/react": "19.2.18",
		"fallow": "^3.0.0",
		"firebase-admin": "^14.2.0",
		"firebase-tools": "^15.28.1",
		"jest": "^30.0.0",
		"jest-expo": "~57.0.0",
		"react-test-renderer": "19.2.8",
		"typescript": "6.0.3"
	},
	"private": true,
	"resolutions": {
		"postcss": ">=8.5.10"
	}
}
