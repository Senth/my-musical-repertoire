{
	"name": "my-musical-repertoire",
	"main": "expo-router/entry",
	"version": "1.0.0",
	"scripts": {
		"start": "expo start",
		"reset-project": "node ./scripts/reset-project.js",
		"android": "expo start --android",
		"ios": "expo start --ios",
		"web": "expo start --web --port $(scripts/dev-stack.sh dev-port)",
		"build:web": "expo export --platform web",
		"deploy:dev": "firebase deploy --only firestore:rules,firestore:indexes --project default",
		"lint": "biome check",
		"typecheck": "tsc --noEmit",
		"invariants": "scripts/check-invariants.sh",
		"format": "biome format --write",
		"test": "jest",
		"e2e": "playwright test",
		"emulators": "firebase emulators:start"
	},
	"jest": {
		"preset": "jest-expo",
		"transformIgnorePatterns": [
			"node_modules/(?!((jest-)?react-native|@react-native(-community)?|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@unimodules/.*|unimodules|sentry-expo|native-base|react-native-svg|@react-native-firebase|firebase|react-native-paper))"
		],
		"testPathIgnorePatterns": [
			"/node_modules/",
			"/e2e/",
			"/.tmp/"
		]
	},
	"dependencies": {
		"@expo/vector-icons": "15.1.1",
		"@react-native-async-storage/async-storage": "^3.1.0",
		"@react-native-community/slider": "^5.2.0",
		"@react-navigation/bottom-tabs": "7.19.2",
		"@react-navigation/native": "7.4.1",
		"expo": "55.0.31",
		"expo-auth-session": "55.0.18",
		"expo-constants": "55.0.17",
		"expo-crypto": "55.0.19",
		"expo-file-system": "~55.0.26",
		"expo-font": "55.0.8",
		"expo-linking": "55.0.17",
		"expo-localization": "55.0.19",
		"expo-router": "55.0.18",
		"expo-sharing": "~55.0.24",
		"expo-splash-screen": "55.0.25",
		"expo-status-bar": "55.0.6",
		"expo-symbols": "55.0.9",
		"expo-web-browser": "55.0.20",
		"firebase": "12.19.0",
		"i18next": "26.4.2",
		"react": "19.3.0",
		"react-dom": "19.3.0",
		"react-i18next": "17.0.15",
		"react-native": "0.87.1",
		"react-native-draggable-flatlist": "^4.0.3",
		"react-native-gesture-handler": "3.3.0",
		"react-native-paper": "5.15.3",
		"react-native-reanimated": "4.7.0",
		"react-native-safe-area-context": "5.10.0",
		"react-native-screens": "4.28.0",
		"react-native-svg": "15.15.5",
		"react-native-web": "0.21.2",
		"react-native-worklets": "0.13.0"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.14",
		"@playwright/test": "^1.62.1",
		"@react-native/jest-preset": "^0.87.0",
		"@testing-library/react-native": "~14.0.0",
		"@types/jest": "~30",
		"@types/node": "^26.3.0",
		"@types/react": "19.3.0",
		"fallow": "^3.0.0",
		"firebase-admin": "^14.2.0",
		"firebase-tools": "^15.28.1",
		"jest": "^30.0.0",
		"jest-expo": "~57.0.0",
		"test-renderer": "1.3",
		"typescript": "6.0.3"
	},
	"private": true,
	"resolutions": {
		"postcss": ">=8.5.10"
	}
}
